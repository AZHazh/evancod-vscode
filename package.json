{
  "name": "vscode-evancod",
  "displayName": "Evancod",
  "description": "AI-powered coding agent for VSCode",
  "version": "1.1.7",
  "publisher": "evancod",
  "icon": "resources/extension-icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "evancod.openChat",
        "title": "Evancod: 打开聊天",
        "icon": "resources/extension-icon.png"
      },
      {
        "command": "evancod.newSession",
        "title": "Evancod: 新建会话",
        "icon": "$(add)"
      },
      {
        "command": "evancod.syncNewApi",
        "title": "Evancod: 同步中转",
        "icon": "$(sync)"
      },
      {
        "command": "evancod.addFileToChat",
        "title": "将文件添加到Evancod"
      },
      {
        "command": "evancod.addSelectionToChat",
        "title": "将所选内容添加到Evancod"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "evancod",
          "title": "Evancod",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "evancod": [
        {
          "type": "webview",
          "id": "evancod.chatView",
          "name": "聊天",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "evancod.openChat",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "evancod.addFileToChat",
          "when": "!explorerResourceIsFolder",
          "group": "evancod@1"
        }
      ],
      "editor/context": [
        {
          "command": "evancod.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "evancod@1"
        }
      ]
    },
    "configuration": {
      "title": "Evancod",
      "properties": {
        "evancod.model": {
          "type": "string",
          "default": "claude-opus-4-8",
          "description": "默认使用的模型"
        },
        "evancod.effortLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ],
          "default": "high",
          "description": "推理程度"
        },
        "evancod.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "bypassPermissions"
          ],
          "default": "default",
          "description": "权限模式"
        },
        "evancod.newApiSiteUrl": {
          "type": "string",
          "default": "https://www.tiandouai.com",
          "description": "new-api 同步授权站点地址"
        },
        "evancod.compactKeepRecentMessages": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 50,
          "description": "旧版上下文压缩保留消息数量",
          "deprecationMessage": "已改为按 token 预算保留，请使用 compactRetainTokens。"
        },
        "evancod.compactRetainTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "压缩后近期原文的 token 预算；0 表示有效输入窗口的 16%。工具调用与结果成组保留。"
        },
        "evancod.compactUserMessageTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "用户原文的独立保护预算；0 表示有效输入窗口的 10%，最多 20000 tokens。最新用户请求始终保留。"
        },
        "evancod.maxExecutionSegments": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "有未完成任务且持续取得进展时，单次请求最多自动续跑的执行段数（每段默认 100 轮）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .tmp/out-tests/regression-tests/agent-runtime.test.js .tmp/out-tests/regression-tests/memory.test.js .tmp/out-tests/regression-tests/repetition.test.js .tmp/out-tests/regression-tests/task-workflow.test.js .tmp/out-tests/regression-tests/compaction.test.js .tmp/out-tests/regression-tests/conversation-runtime.test.js .tmp/out-tests/regression-tests/file-preview.test.js .tmp/out-tests/regression-tests/steering.test.js",
    "test": "node ./out/test/runTest.js",
    "install:webview": "cd webview && npm install",
    "build:webview": "npm run install:webview && cd webview && npm run build",
    "dev:webview": "cd webview && npm run dev",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1020.0",
    "axios": "^1.14.0",
    "marked": "^17.0.0",
    "diff": "^8.0.0",
    "zod": "^4.3.0"
  }
}
